{
  "name": "lingzhu-frontend",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @lingzhu/desktop run dev",
    "build:dev": "npm --workspace @lingzhu/desktop run build:dev",
    "build": "npm --workspace @lingzhu/desktop run build",
    "test:ui": "npm --workspace @lingzhu/desktop run test:ui",
    "test:dom": "npm --workspace @lingzhu/desktop run test:dom",
    "preview": "npm --workspace @lingzhu/desktop run preview",
    "build:parity": "npm --workspace @lingzhu/desktop run build:parity",
    "test:parity": "npm --workspace @lingzhu/desktop run test:parity"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@pierre/diffs": "1.6.1",
    "@pierre/highlights": "0.2.0",
    "@pierre/theming": "1.0.2",
    "@tanstack/virtual-core": "3.17.8",
    "@wailsio/runtime": "3.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "diff": "8.0.4",
    "pele": "^1.13.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.4.3",
    "simple-icons": "^16.36.0",
    "solid-js": "^1.9.20",
    "solid-markdown": "^2.1.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "vite": "^8.2.4",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.0"
  }
}
