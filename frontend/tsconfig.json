{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "paths": {
      "@lingzhu/ui/*": ["./packages/ui/src/*"],
      "@lingzhu/session-ui/*": ["./packages/session-ui/src/*"],
      "@lingzhu/devtools/*": ["./packages/devtools/src/*"],
      "@lingzhu/app/*": ["./packages/app/src/*"],
      "@lingzhu/bindings/*": ["./apps/desktop/bindings/*"],
      "@/*": ["./packages/app/src/*"]
    },

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["packages/*/src", "apps/desktop/src", "apps/desktop/bindings"]
}
