<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lingzhu-app.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Lingzhu\Lingzhu">
    </Installer>
    <PackageInformation
        PackageName="Lingzhu"
        PackageDisplayName="Lingzhu"
        PublisherName="CN=Lingzhu"
        PublisherDisplayName="Lingzhu"
        Version="0.1.0.0"
        PackageDescription="Desktop client for the lingzhu agent">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.lingzhu.app"
                Description="Desktop client for the lingzhu agent"
                DisplayName="Lingzhu"
                ExecutableName="lingzhu-app.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lingzhu</DisplayName>
            <PublisherDisplayName>Lingzhu</PublisherDisplayName>
            <Description>Desktop client for the lingzhu agent</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lingzhu-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
